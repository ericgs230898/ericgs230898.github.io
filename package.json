    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "rxjs": "^7.8.1",
    "zone.js": "^0.14.4"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-loader": "^9.5.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "css-loader": "^6.10.0",
    "style-loader": "^3.3.4",
    "html-webpack-plugin": "^5.6.0"
  }
